  color: #77837f;
  font-size: .72rem;
}

.candidate-list-v2 .candidate-state {
  grid-column: 1 / -1;
  display: block;
  padding: 8px 10px;
  border-radius: 11px;
  background: rgba(23,107,91,.07);
  color: #176b5b;
  font-size: .72rem;
  font-weight: 800;
  text-align: center;
}

.candidate-no-results {
  display: grid;
  gap: 5px;
  padding: 40px 18px;
  text-align: center;
}

.candidate-no-results strong {
  color: #25312e;
}

.candidate-no-results span {
  color: #7b8783;
  font-size: .82rem;
}

.selected-candidate-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 16px;
  padding: 15px 17px;
  border: 1px solid rgba(23,107,91,.13);
  border-radius: 19px;
  background: rgba(232,246,242,.68);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}

.selected-candidate-summary > div {
  display: grid;
  min-width: 0;
  gap: 3px;
}

.selected-candidate-summary div span {
  color: #75817d;
  font-size: .68rem;
}

.selected-candidate-summary div strong {
  overflow: hidden;
  color: #25312e;
  font-size: .9rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-candidate-number {
  color: #176b5b;
  font-size: 1.65rem;
  font-weight: 900;
  letter-spacing: -.04em;
}

.candidate-footer-v2 {
  display: grid;
  gap: 13px;
  margin-top: 22px;
}

.candidate-footer-v2 p {
  margin: 0;
  color: #8a9591;
  font-size: .68rem;
  line-height: 1.4;
  text-align: center;
}

.continue-v2 {
  display: flex;
  width: 100%;
  min-height: 60px;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  border: 0;
  border-radius: 18px;
  background: #176b5b;
  box-shadow: 0 16px 34px rgba(23,107,91,.2);
  color: #fff;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 160ms ease,
    opacity 160ms ease;
}

.continue-v2:not(:disabled):active {
  transform: scale(.985);
}

.continue-v2:disabled {
  box-shadow: none;
  cursor: not-allowed;
  opacity: .38;
}

.candidate-secondary-controls {
  display: flex;
  justify-content: center;
  gap: 18px;
  margin-top: 18px;
}

.candidate-secondary-controls .clear-ballot,
.candidate-secondary-controls .change-uf {
  margin: 0;
  font-size: .72rem;
}

@media (min-width: 680px) {
  .candidate-selection-v2 {
    padding-top: 34px;
  }

  .candidate-list-v2 .candidate-card {
    grid-template-columns: 76px minmax(0,1fr) auto;
  }

  .candidate-list-v2 .candidate-photo {
    width: 76px;
    height: 86px;
  }

  .candidate-list-v2 .candidate-state {
    grid-column: auto;
    min-width: 96px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .candidate-progress-track > span,
  .candidate-list-v2 .candidate-card,
  .continue-v2 {
    transition: none;
  }
}

/* =========================================================
   Meu Santinho — Digital Ballot / Completed V2
   ========================================================= */

.completed-v2 {
  width: min(100%, 620px);
  margin: 0 auto;
  padding: 34px 0 64px;
}

.completed-heading {
  margin-bottom: 24px;
  text-align: center;
}

.completed-badge {
  display: inline-flex;
  min-height: 30px;
  align-items: center;
  padding: 0 12px;
  border: 1px solid rgba(23, 107, 91, .13);
  border-radius: 999px;
  background: rgba(23, 107, 91, .08);
  color: #176b5b;
  font-size: .7rem;
  font-weight: 850;
  letter-spacing: .03em;
}

.completed-heading h1 {
  margin: 13px 0 4px;
  color: #17211f;
  font-size: clamp(2rem, 9vw, 3.3rem);
  line-height: 1;
  letter-spacing: -.055em;
}

.completed-heading p {
  margin: 0;
  color: #7a8682;
  font-size: .82rem;
}

.digital-ballot {
  position: relative;
  overflow: hidden;
  padding: 22px 18px 18px;
  border: 1px solid rgba(255, 255, 255, .25);
  border-radius: 30px;
  background:
    radial-gradient(
      circle at 15% 0%,
      rgba(64, 118, 151, .25),
      transparent 34%
    ),
    radial-gradient(
      circle at 100% 70%,
      rgba(31, 128, 106, .17),
      transparent 32%
    ),
    linear-gradient(155deg, #172b42 0%, #101e33 48%, #0b1728 100%);
  box-shadow:
    0 34px 80px rgba(8, 24, 35, .25),
    inset 0 1px 0 rgba(255, 255, 255, .12);
  color: #fff;
}

.digital-ballot::before {
  position: absolute;
  width: 220px;
  height: 220px;
  top: -100px;
  right: -100px;
  border-radius: 50%;
  background: rgba(255, 255, 255, .04);
  content: "";
  filter: blur(2px);
}

.digital-ballot-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.digital-ballot-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.digital-ballot-logo {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, .18);
  border-radius: 13px;
  background: rgba(255, 255, 255, .09);
  color: #fff;
  font-size: .7rem;
  font-weight: 900;
  letter-spacing: .04em;
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}

.digital-ballot-brand > div {
  display: grid;
  gap: 2px;
}

.digital-ballot-brand strong {
  font-size: .84rem;
}

.digital-ballot-brand div span {
  color: rgba(255, 255, 255, .58);
  font-size: .62rem;
}

.digital-ballot-uf {
  display: grid;
  min-width: 39px;
  height: 30px;
  padding: 0 9px;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, .13);
  border-radius: 999px;
  background: rgba(255, 255, 255, .07);
  color: rgba(255, 255, 255, .82);
  font-size: .66rem;
  font-weight: 800;
}

.digital-ballot-divider {
  height: 1px;
  margin: 18px 0 7px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, .13),
    transparent
  );
}

.digital-ballot-choices {
  position: relative;
  z-index: 1;
}

.digital-ballot-choice {
  display: grid;
  justify-items: center;
  padding: 15px 4px;
  border-bottom: 1px solid rgba(255, 255, 255, .065);
  text-align: center;
}

.digital-ballot-choice:last-child {
  border-bottom: 0;
}

.digital-ballot-office {
  margin-bottom: 8px;
  color: rgba(255, 255, 255, .58);
  font-size: .59rem;
  font-weight: 800;
  letter-spacing: .095em;
  text-transform: uppercase;
}

.digital-ballot-digits {
  display: flex;
  justify-content: center;
  gap: 5px;
}

.digital-ballot-digit {
  display: grid;
  width: clamp(38px, 11vw, 52px);
  height: clamp(45px, 13vw, 59px);
  place-items: center;
  border: 1px solid rgba(255, 255, 255, .16);
  border-radius: 11px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, .13),
      rgba(255, 255, 255, .055)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, .14),
    0 8px 18px rgba(0, 0, 0, .12);
  color: #f8fbff;
  font-size: clamp(1.35rem, 6vw, 1.85rem);
  font-weight: 850;
  line-height: 1;
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}

.digital-ballot-name {
  max-width: 90%;
  margin-top: 8px;
  overflow: hidden;
  color: rgba(255, 255, 255, .91);
  font-size: .7rem;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.digital-ballot-party {
  margin-top: 2px;
  color: rgba(255, 255, 255, .42);
  font-size: .57rem;
  font-weight: 700;
}

.digital-ballot-message {
  position: relative;
  z-index: 1;
  margin-top: 15px;
  padding: 20px 17px;
  border: 1px solid rgba(255, 255, 255, .12);
  border-radius: 19px;
  background: rgba(255, 255, 255, .065);
  text-align: center;
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}

.digital-ballot-message > strong {
  display: block;
  color: #fff;
  font-size: .78rem;
  font-weight: 900;
  letter-spacing: .06em;
}

.digital-ballot-message p {
  max-width: 350px;
  margin: 7px auto 0;
  color: rgba(255, 255, 255, .66);
  font-size: .69rem;
  line-height: 1.55;
}

.digital-ballot-message b {
  color: #fff;
  font-weight: 900;
}

.digital-ballot-footer {
  display: flex;
  justify-content: center;
  gap: 7px;
  padding-top: 16px;
  color: rgba(255, 255, 255, .35);
  font-size: .55rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.completed-saved {
  margin: 18px 0 0;
  color: #65736e;
  font-size: .72rem;
  text-align: center;
}

.completed-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 9px;
  margin-top: 20px;
}

.completed-actions .completed-edit,
.completed-actions .completed-state {
  width: 100%;
  margin: 0;
}

.completed-v2 > .clear-ballot {
  display: block;
  margin: 16px auto 0;
}

@media (min-width: 540px) {
  .digital-ballot {
    padding: 28px 28px 22px;
  }

  .digital-ballot-choice {
    padding: 17px 4px;
  }

  .completed-actions {
    grid-template-columns: 1fr 1fr;
  }
}
